produtos = []

def cadastrar():
    nome = input("Nome do produto: ")
    preco = float(input("Preço: "))
    estoque = int(input("Quantidade em estoque: "))

    produto = {
        "nome": nome,
        "preco": preco,
        "estoque": estoque
    }

    produtos.append(produto)
    print("Produto cadastrado com sucesso!")


def listar():
    if len(produtos) == 0:
        print("Nenhum produto cadastrado.")
    else:
        print("\n--- PRODUTOS ---")

        for i, produto in enumerate(produtos):
            print("ID:", i)
            print("Nome:", produto["nome"])
            print("Preço: R$", produto["preco"])
            print("Estoque:", produto["estoque"])
            print("----------------")


def atualizar():
    listar()

    id = int(input("Digite o ID do produto que deseja alterar: "))

    if id < len(produtos):
        produtos[id]["nome"] = input("Novo nome: ")
        produtos[id]["preco"] = float(input("Novo preço: "))
        produtos[id]["estoque"] = int(input("Novo estoque: "))

        print("Produto atualizado!")
    else:
        print("Produto não encontrado.")


def excluir():
    listar()

    id = int(input("Digite o ID do produto que deseja excluir: "))

    if id < len(produtos):
        produtos.pop(id)
        print("Produto excluído!")
    else:
        print("Produto não encontrado.")


while True:

    print("\n===== MERCADO LIVRE =====")
    print("1 - Cadastrar produto")
    print("2 - Listar produtos")
    print("3 - Atualizar produto")
    print("4 - Excluir produto")
    print("5 - Sair")

    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        cadastrar()

    elif opcao == "2":
        listar()

    elif opcao == "3":
        atualizar()

    elif opcao == "4":
        excluir()

    elif opcao == "5":
        print("Sistema encerrado.")
        break

    else:
        print("Opção inválida.")
